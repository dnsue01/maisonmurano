# Dominio de la tienda Shopify de Maison Murano. El catálogo (productos,
# precios, stock, fotos) se lee en directo de /products.json.
SHOPIFY_STORE_DOMAIN=maisonmurano.es

# Opcional: token privado de la Storefront API (canal "Headless") para pasar
# de products.json a la Storefront API cuando la marca dé acceso.
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
